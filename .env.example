# Copy to .env (never commit .env)  — all backend (Person B)
SARVAM_API_KEY=              # TTS + translate proxy (E24/E25). Empty → those return 503, rest still works
LLM_PROVIDER=gemini          # gemini (free tier, implemented) | anthropic (implemented). Briefing + Q&A; optional — template fallback without a key
LLM_API_KEY=                 # Gemini: free key from https://aistudio.google.com/apikey
LLM_MODEL=                   # empty = default (gemini-3.8-flash / claude-opus-5)
DATABASE_URL=sqlite:///./rebase.db
SIM_TICK_SECONDS=1           # telemetry stream rate
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # RAG embeddings (downloaded once)
CHROMA_DIR=./data/models/chroma                          # vector store location
ESTIMATOR_PATH=./data/models/estimator.json              # XGBoost job-time model (python -m app.ai.train_estimator)
